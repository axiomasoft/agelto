[Unit]
Description=Agelto verified production backup
After=docker.service network-online.target
Wants=network-online.target
OnFailure=agelto-backup-alert@%n.service
ConditionPathExists=/etc/agelto/operator-rehearsal-authority

[Service]
Type=oneshot
User=deploy
Group=deploy
UMask=0077
WorkingDirectory=/srv/agelto/repository
ExecStart=/usr/local/bin/agelto-backup apply --profile /etc/agelto/production-profile --authority-file /etc/agelto/operator-rehearsal-authority
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/agelto/backups
