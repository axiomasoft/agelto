# Copy to docker/host/production-profile, fill with production values, then chmod 0600.
# The parser accepts only these keys. Values below are deliberately rejected placeholders.
DEPLOY_USER=deploy
DEPLOY_AUTHORIZED_KEY_FILE=/root/.ssh/agelto-deploy.pub
SSH_PORT=22
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
APP_BIND_ADDRESS=127.0.0.1
APP_BIND_PORT=8080
DISK_MIN_FREE_GB=20
DOCKER_DATA_ROOT=/var/lib/docker
REGISTRY_PASSWORD_FILE=/root/.config/agelto/registry-password
BACKUP_ALERT_URL_FILE=/root/.config/agelto/backup-alert-url
AGELTO_REPOSITORY=CHANGE_ME_OWNER/CHANGE_ME_REPOSITORY
AGELTO_CANDIDATE_SHA=CHANGE_ME_FULL_40_HEX_SHA
AGELTO_CHECKOUT_DIR=/srv/agelto/repository
GITHUB_ED25519_HOST_KEY=CHANGE_ME_GITHUB_ED25519_KEY

# Vendor repository/SHA pins come only from docker/private-vendors.lock.json.
# github-agelto, github-azguard and github-proxyma each use a distinct read-only key.
# prepare prints public fingerprints; enrollment and production sync are operator steps.
