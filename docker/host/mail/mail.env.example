# Host-only profile. No credentials: application SMTP is private to Agelto's network.
COMPOSE_PROFILES=
AGELTO_SMTP_IMAGE=boky/postfix:5.1.0@sha256:REPLACE_WITH_VERIFIED_DIGEST
MAIL_SENDER_DOMAIN=agelto.ru
MAIL_EHLO_DOMAIN=flexl.ru
AGELTO_SMTP_APP_NETWORK=agelto_prod_agelto_network
AGELTO_SMTP_TRUSTED_NETWORKS=127.0.0.0/8,172.21.0.0/16
