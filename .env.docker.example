# Docker Compose: порты хоста и настройки, специфичные для Docker.
# Скопируйте в .env.docker и подставьте свои значения.
# Переменные приложения (DB, Redis creds, APP_URL и т.д.) — в .env.

APP_PORT=8080
VITE_PORT=5173
PGSQL_PORT=5432
REDIS_PORT=6379
REVERB_SERVER_PORT=8000
DOCS_PORT=4173

# UID/GID хоста для файловых прав в контейнере (id -u / id -g).
PUID=1000
PGID=1000
