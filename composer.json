{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "agelto/agelto",
    "type": "project",
    "description": "Agelto \u2014 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430 \u0441\u0431\u043e\u0440\u0430, \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0438 AI-\u0440\u0430\u0437\u0431\u043e\u0440\u0430 \u0437\u0430\u043a\u0443\u043f\u043e\u043a.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "local/vendors/azguard/packages/core",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "local/vendors/azguard/packages/filament",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "axioma-studio/azguard-core": "@dev",
        "axioma-studio/azguard-filament": "@dev",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.47",
        "laravel/pulse": "^1.7",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "*",
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpspreadsheet": "^5.4",
        "prism-php/prism": "^0.100.1",
        "sentry/sentry-laravel": "^4.26",
        "spatie/laravel-data": "^4.23",
        "symfony/css-selector": "*",
        "symfony/dom-crawler": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "*",
        "laravel/boost": "^2.4",
        "laravel/doctor": "^0.1.0",
        "laravel/pail": "^1.2.2",
        "laravel/pao": "*",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "*",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "yarn install",
            "yarn build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "yarn dlx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"yarn dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
