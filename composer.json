{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "agelto/agelto",
    "type": "project",
    "description": "Agelto \u2014 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430 \u0441\u0431\u043e\u0440\u0430, \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0438 AI-\u0440\u0430\u0437\u0431\u043e\u0440\u0430 \u0437\u0430\u043a\u0443\u043f\u043e\u043a.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "local/vendors/azguard/packages/core",
            "options": {
                "symlink": false,
                "versions": {
                    "axiomasoft/azguard": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "local/vendors/azguard/packages/filament",
            "options": {
                "symlink": false,
                "versions": {
                    "axiomasoft/azguard-filament": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "local/vendors/proxyma/packages/core",
            "options": {
                "symlink": false,
                "reference": "config",
                "versions": {
                    "axiomasoft/proxyma": "0.1.0"
                }
            }
        },
        {
            "type": "path",
            "url": "local/vendors/proxyma/packages/filament",
            "options": {
                "symlink": false,
                "reference": "config",
                "versions": {
                    "axiomasoft/proxyma-filament": "0.1.0"
                }
            }
        }
    ],
    "require": {
        "axiomasoft/azguard": "dev-main",
        "axiomasoft/azguard-filament": "dev-main",
        "axiomasoft/proxyma": "0.1.0",
        "axiomasoft/proxyma-filament": "0.1.0",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.47",
        "laravel/pulse": "^1.7",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "mpdf/mpdf": "^8.2",
        "opis/json-schema": "2.6.0",
        "php": "^8.4",
        "phpoffice/phpspreadsheet": "^5.4",
        "sentry/sentry-laravel": "^4.26",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-settings": "^3.9",
        "symfony/css-selector": "^8.1",
        "symfony/dom-crawler": "^8.1"
    },
    "require-dev": {
        "driftingly/rector-laravel": "2.5.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "*",
        "laravel/boost": "^2.4",
        "laravel/doctor": "^0.1.0",
        "laravel/pail": "^1.2.2",
        "laravel/pao": "*",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "*",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "2.6.2"
    },
    "autoload": {
        "files": ["bootstrap/proxyma.php"],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r 'if (strtolower(trim((string) getenv(\"APP_ENV\"))) === \"production\" || (is_file(\"bootstrap/cache/config.php\") && strtolower((string) ((@include \"bootstrap/cache/config.php\")[\"app\"][\"env\"] ?? \"\")) === \"production\") || (is_file(\".env\") && preg_match(\"/^\\s*(?:export\\s+)?APP_ENV\\s*=\\s*[\\x22\\x27]?production[\\x22\\x27]?\\s*(?:#.*)?\\x24/mi\", (string) file_get_contents(\".env\")) === 1)) { fwrite(STDERR, \"Refusing to run composer setup in production environment.\".PHP_EOL); exit(1); }'",
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r 'if (trim((string) getenv(\"APP_KEY_FILE\")) !== \"\") { if (!is_file(trim((string) getenv(\"APP_KEY_FILE\"))) || !is_readable(trim((string) getenv(\"APP_KEY_FILE\"))) || trim((string) file_get_contents(trim((string) getenv(\"APP_KEY_FILE\")))) === \"\") { fwrite(STDERR, \"APP_KEY_FILE is set but unreadable or empty.\".PHP_EOL); exit(1); } exit(0); } if (trim((string) getenv(\"APP_KEY\")) !== \"\" || (is_file(\".env\") && preg_match(\"/^\\s*(?:export\\s+)?APP_KEY\\s*=\\s*(?![\\x22\\x27]?\\s*(?:#|\\x24))\\S+/m\", (string) file_get_contents(\".env\")) === 1)) { exit(0); } passthru(escapeshellarg(PHP_BINARY).\" artisan key:generate --ansi\", $status); exit($status);'",
            "@php artisan migrate --no-interaction",
            "pnpm install",
            "pnpm build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm exec concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"pnpm dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "axiomasoft/proxyma",
                "axiomasoft/proxyma-filament"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "PKSA-kwst-yd6p-pksp": "Transitive filament/actions dependency; CSV CharsetConverter is not used."
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
