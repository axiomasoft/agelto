APP_NAME=Agelto
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=agelto
DB_USERNAME=agelto
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=default

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Dev Server Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_HMR_HOST=localhost
VITE_HMR_PORT=
VITE_USE_POLLING=true

# --- REDIS ---
# Внутри Docker используем имя сервиса 'redis'
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- REVERB ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8000
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8000

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- DOCKER (см. также .env.docker.example) ---
PGSQL_PORT=5432
REDIS_PORT=6379
APP_PORT=8080
DOCS_PORT=4173
PUID=1000
PGID=1000

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- EIS ---
EIS_AUTH_URL=https://eis-auth.local:8443/oauth/token
EIS_API_BASE=https://eis-api.local:8443

# --- GEMINI ---
GEMINI_API_KEY=
GEMINI_PROXY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- MEDIA ---
MEDIA_DISK=media
MEDIA_PRIVATE_DISK=media-private

# Playwright MCP proxy — used by the "playwright" server in .mcp.json
# Format: http://user:pass@host:port  (or socks5://host:port). Leave empty to disable.
PLAYWRIGHT_MCP_PROXY_SERVER=
