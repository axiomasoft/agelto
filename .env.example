APP_NAME=Agelto
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=agelto
DB_USERNAME=agelto
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (S3-совместимое object storage), см. docs/specs/v2/00-overview.md §3
AWS_ACCESS_KEY_ID=agelto
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=agelto
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=
AI_GEMINI_PROXY=

# P7.2 — ai:cost-report: курс для рублёвой колонки отчёта (config/ai.php cost_report.rub_per_usd)
AI_COST_REPORT_RUB_PER_USD=90.0

# P7.3 — pipeline:stuck-check (EST-AI)
AI_MODEL_EOL_WARN_DAYS=30
AI_PIPELINE_ANALYSIS_STUCK_MINUTES=30
AI_PIPELINE_CHECKPOINT_STUCK_MINUTES=60
AI_PIPELINE_DOCUMENT_STUCK_MINUTES=60
AI_PIPELINE_SPIKE_WINDOW_HOURS=24
AI_PIPELINE_UNKNOWN_SPIKE_THRESHOLD=20
AI_PIPELINE_UNPROCESSABLE_SPIKE_THRESHOLD=5
AI_PIPELINE_ESTIMATE_MISMATCH_THRESHOLD=5
AI_PIPELINE_ALERT_ANTISPAM_MINUTES=60

# DOMLANG P5.1 — TTL unique-лока pipeline-job’ов (PipelineJob::uniqueFor(), ADR-0009)
AI_PIPELINE_UNIQUE_LOCK_MINUTES=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# EST-AI P7.5 — Observability (Sentry/GlitchTip, Pulse, JSON-логи, SQL-алерты стадий)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
PULSE_ENABLED=true
PULSE_PATH=pulse
LOG_CHANNEL=stack
AI_PIPELINE_BACKLOG_THRESHOLD=200
AI_PIPELINE_FAILURE_RATE_WINDOW_HOURS=1
AI_PIPELINE_FAILURE_RATE_THRESHOLD_PERCENT=50
AI_PIPELINE_NO_COMPLETIONS_MINUTES=120

# P7.7 — Data lifecycle: retention партиций (D33), MinIO ILM (config/partitioning.php)
AI_RETENTION_LLM_CALLS_MONTHS=12
AI_RETENTION_FETCHES_MONTHS=6
AI_RETENTION_OPERATION_LOGS_MONTHS=6
AI_RETENTION_EVENTS_MONTHS=6
AI_STORAGE_LLM_BLOBS_EXPIRE_DAYS=90
