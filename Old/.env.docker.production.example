# Prod-only: порты хоста для production (docker-compose.prod.yml).
# Читается только prod-целями Makefile (make up ENV=prod или make prod:*).
# Переменные приложения (APP_KEY, DB_PASSWORD и т.д.) — в .env на сервере.
#
# Если файл не найден, Makefile выведет ошибку:
#   Ошибка: .env.docker.production не найден. cp .env.docker.production.example .env.docker.production

APP_PORT=8080
PGSQL_PORT=5432
REDIS_PORT=6379
REVERB_SERVER_PORT=8000
DOCS_PORT=4173
