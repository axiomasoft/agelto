# Dev-only: порты хоста для локальной разработки (docker-compose.yml).
# Для production используйте .env.docker.production:
#   cp .env.docker.production.example .env.docker.production
# Переменные приложения (DB, Redis creds, APP_URL и т.д.) — в .env.

APP_PORT=8081
VITE_PORT=5175
PGSQL_PORT=5434
REDIS_PORT=6380
REVERB_SERVER_PORT=8001
DOCS_PORT=4174

# UID/GID хоста для файловых прав в контейнере (id -u / id -g).
PUID=1000
PGID=1000
