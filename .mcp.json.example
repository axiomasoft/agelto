{
  "mcpServers": {
    "laravel-boost": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "agelto_app",
        "php",
        "artisan",
        "boost:mcp"
      ]
    },
    "maind": {
      "command": "${MAIND_BIN:-maind}",
      "args": [
        "mcp",
        "--scope",
        "project:agelto"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "<ABS_PATH_TO_PROJECT>",
        "--enable-web-dashboard",
        "false"
      ]
    },
    "playwright": {
      "command": "bash",
      "args": [
        "scripts/playwright-mcp.sh"
      ]
    },
    "perplexity-web": {
      "command": "${PERPLEXITY_WEB_MCP_BIN:-<HOME>/projects/packages/perplexity-web-mcp/start.sh}",
      "args": [
        "--pool=default"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
