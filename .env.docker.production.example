# Docker Compose (prod) — переменные уровня хоста/портов для docker-compose.prod.yml.
# Скопируйте: cp .env.docker.production.example .env.docker.production
# Секреты живут только в ignored local/secrets/, создайте их через make secrets:init.

APP_PORT=8080
PGSQL_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ROOT_USER=agelto
MINIO_BUCKET=agelto
MINIO_ESTIMATES_BUCKET=agelto-estimates
SETTINGS_CACHE_ENABLED=false
SETTINGS_CACHE_MEMO=false

LOG_LEVEL=warning
