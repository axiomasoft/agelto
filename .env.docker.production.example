# Docker Compose (prod) — переменные уровня хоста/портов для docker-compose.prod.yml.
# Скопируйте: cp .env.docker.production.example .env.docker.production
# Секреты (APP_KEY/DB_PASSWORD/REDIS_PASSWORD/MinIO-пароль) — через Docker Swarm secrets
# (см. комментарий в docker-compose.prod.yml), НЕ через эти переменные.

APP_PORT=8080
PGSQL_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ROOT_USER=agelto
MINIO_BUCKET=agelto

LOG_LEVEL=warning
