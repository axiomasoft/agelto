{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Procurement Listing Parsing Rule Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "transport",
    "date_parsing"
  ],
  "properties": {
    "format": {
      "type": "string",
      "enum": ["csv", "html", "json"]
    },
    "transport": {
      "$ref": "#/$defs/listingTransportRule"
    },
    "date_parsing": {
      "$ref": "#/$defs/dateParsingRule"
    },
    "csv_dialect": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/csvDialectRule" }
      ]
    },
    "columns": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/listingColumnsRule" }
      ]
    },
    "json_listing": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/jsonListingRule" }
      ]
    },
    "external_id_regex": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/regexPattern" }
      ]
    },
    "detail_url_template": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "format": { "const": "csv" } }
      },
      "then": {
        "required": ["csv_dialect", "columns"],
        "properties": {
          "csv_dialect": { "$ref": "#/$defs/csvDialectRule" },
          "columns": { "$ref": "#/$defs/listingColumnsRule" }
        }
      }
    },
    {
      "if": {
        "properties": { "format": { "const": "html" } }
      },
      "then": {
        "required": ["columns"],
        "properties": {
          "columns": { "$ref": "#/$defs/listingColumnsRule" }
        }
      }
    },
    {
      "if": {
        "properties": { "format": { "const": "json" } }
      },
      "then": {
        "required": ["json_listing"],
        "properties": {
          "json_listing": { "$ref": "#/$defs/jsonListingRule" }
        }
      }
    }
  ],
  "$defs": {
    "cssSelector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "selectorChain": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cssSelector" }
    },
    "nullableSelectorChain": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/selectorChain" }
      ]
    },
    "regexPattern": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512
    },
    "nullableRegexPattern": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/regexPattern" }
      ]
    },
    "nullableString": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "csvDialectRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
        "enclosure": { "type": "string", "minLength": 1, "maxLength": 1 },
        "escape": { "type": "string", "maxLength": 1 },
        "encoding": { "type": "string", "minLength": 1 },
        "strip_bom": { "type": "boolean" },
        "skip_empty_rows": { "type": "boolean" },
        "header_row_index": { "type": "integer", "minimum": 0 }
      }
    },
    "listingTransportRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "page_param": { "$ref": "#/$defs/nullableString" },
        "page_size_param": { "$ref": "#/$defs/nullableString" },
        "default_page_size": { "type": "integer", "minimum": 1 },
        "item_link_selectors": { "$ref": "#/$defs/nullableSelectorChain" },
        "next_page_selectors": { "$ref": "#/$defs/nullableSelectorChain" }
      }
    },
    "columnMappingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_field"],
      "properties": {
        "target_field": { "type": "string", "minLength": 1 },
        "header_aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "column_index": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "required": { "type": "boolean" },
        "value_regex": { "$ref": "#/$defs/nullableRegexPattern" }
      }
    },
    "listingColumnsRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/columnMappingRule" }
        },
        "row_selectors": { "$ref": "#/$defs/nullableSelectorChain" },
        "deduplicate_by_field": { "$ref": "#/$defs/nullableString" }
      }
    },
    "dateParsingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "timezone": { "type": "string", "minLength": 1 },
        "extract_regex": { "$ref": "#/$defs/nullableRegexPattern" }
      }
    },
    "jsonListingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items_path", "field_paths"],
      "properties": {
        "items_path": { "type": "string", "minLength": 1 },
        "field_paths": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "total_path": { "$ref": "#/$defs/nullableString" },
        "next_cursor_path": { "$ref": "#/$defs/nullableString" }
      }
    }
  }
}
