                            "null"
                        ]
                    }
                },
                "required": [
                    "name"
                ],
                "additionalProperties": false
            },
            "RowQuality": {
                "type": "object",
                "properties": {
                    "reason": {
                        "description": "причина, по которой перечисленные поля строки нельзя считать надёжными; модель вправе вернуть только unreadable — величину не удалось прочитать в источнике.",
                        "type": "string",
                        "enum": [
                            "unreadable",
                            "arithmetic_mismatch",
                            "numbering_gap"
                        ]
                    },
                    "fields": {
                        "description": "имена полей EstimateRow, которых касается причина (например quantity, total_price_curr); пустой список запрещён — пометка без адреса.",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "reason",
                    "fields"
                ],
                "additionalProperties": false
            },
            "RowResource": {
                "type": "object",
                "properties": {
                    "resource_type": {
                        "description": "категория ресурса — material/machine/labor/overhead/other.",
                        "type": "string",
                        "enum": [
                            "labor",
                            "machine",
                            "material",
                            "overhead",
                            "other"
                        ]
                    },
                    "name": {
                        "description": "наименование ресурса.",
                        "type": "string"
                    },
                    "code": {
                        "description": "шифр ресурса, если указан.",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "unit": {
                        "description": "единица измерения (цитата документа; разбор на базу/множитель — бэкенд, вне контракта).",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "quantity": {
                        "description": "количество (decimal-строка — конверсия во float запрещена).",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "price_base": {
                        "description": "цена ресурса на базисном уровне (decimal-строка) — пуста у ресурсной сметы (calc_method=resource), это законное состояние, а не потеря.",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "price_curr": {
                        "description": "цена ресурса на текущем уровне (decimal-строка).",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "index_code": {
                        "description": "код индекса пересчёта ресурса — второй множитель арифметики «базис × индекс ≈ текущая», не подпись индекса (она не хранится).",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "index_value": {
                        "description": "значение индекса пересчёта ресурса — второй множитель арифметики «базис × индекс ≈ текущая», не подпись индекса (она не хранится).",
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "resource_type",
                    "name"
                ],
                "additionalProperties": false
            }
        },
        "type": "object",
        "properties": {
            "rows": {
                "description": "плоский список строк запрошенного диапазона/окна (включая заголовки разделов и промежуточные итоги).",
                "type": "array",
                "items": {
                    "$ref": "#/$defs/EstimateRow"
                }
            },
            "incomplete_items": {
                "description": "буфер незавершённых строк на границе нарезки.",
                "type": "array",
                "items": {
                    "$ref": "#/$defs/IncompleteRow"
                }
            }
        },
        "required": [],
        "additionalProperties": false
    },
    "ScreeningResult": {
        "type": "object",
        "properties": {
            "document_type": {
                "description": "тип документа — estimate/tech_spec/contract_draft/protocol/unknown.",
                "type": "string",
                "enum": [
                    "estimate",
                    "tech_spec",
                    "contract_draft",
                    "protocol",
                    "unknown"
                ]
            },
            "confidence": {
                "description": "уверенность модели в классификации, от 0 (совсем не уверена) до 1 (полностью уверена).",
                "type": "number"
            },
            "summary": {
                "description": "краткое обязательное резюме видимого содержания документа; 1–1000 символов.",
                "type": "string"
            },
            "estimate_cardinality": {
                "description": "сколько логических смет видно в одном документе: none/single/multiple/unknown.",
                "type": "string",
                "enum": [
                    "none",
                    "single",
                    "multiple",
                    "unknown"
                ]
            },
            "tags": {
                "description": "нормализованные метки видимого содержания: 0–12 непустых значений, до 64 символов каждое.",
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "classification_note": {
                "description": "необязательное пояснение классификации по видимому содержанию; не является backend-решением.",
                "type": [
                    "string",
                    "null"
                ]
            }
        },
        "required": [
            "document_type",
            "confidence",
            "summary",
            "estimate_cardinality",
            "tags"
        ],
        "additionalProperties": false
    },
    "TotalsResponse": {
        "$defs": {
            "EstimateTotalsBlock": {
                "type": "object",
                "properties": {
                    "footer": {
                        "description": "корневые итоговые строки сметы (рекурсивные — см. TotalLine.children).",
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/TotalLine"
                        }
                    }
                },
                "required": [],
                "additionalProperties": false
            },
            "TotalLine": {
                "type": "object",
                "properties": {
                    "label": {
                        "description": "подпись строки («Итого», «в том числе НДС», «Накладные расходы»).",
                        "type": "string"
                    },
                    "value": {
                        "description": "сумма строкой (decimal без потерь — конверсия во float запрещена); nullable — начисление, заданное процентом (см. rate), может не иметь собственной суммы в документе.",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "kind": {
                        "description": "машиночитаемая пометка типа начисления, если модель распознаёт по label; иначе null — детерминированное доопределение по label этим планом не строится (долг).",
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "overhead",
                            "profit",
                            "vat",
                            "total",
                            "additional",
                            "other"
                        ]
                    },
                    "chapter_number": {
                        "description": "номер главы сводного расчёта, если начисление привязано к главе.",
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "rate": {
                        "description": "ставка начисления в процентах, если задано процентом, а не суммой — признак «задано процентом» — это rate !== null, отдельного булева нет.",
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "children": {
                        "description": "вложенные строки («в том числе»).",
                        "type": "array",
                        "items": {
                            "$ref": "#/$defs/TotalLine"
                        }
                    }
                },
                "required": [
                    "label"
                ],
                "additionalProperties": false
            }
        },
        "type": "object",
        "properties": {
            "totals": {
                "description": "итоги/начисления сметы (дерево, см. EstimateTotalsBlock).",
                "$ref": "#/$defs/EstimateTotalsBlock"
            }
        },
        "required": [
            "totals"
        ],
        "additionalProperties": false
    }
